# Base URL of the backend API.
# Leave as /api to use the Vite dev proxy (see vite.config.js).
VITE_API_URL=/api

# Base URL for static assets (profile photos at /uploads/avatars/...).
# Leave blank in dev — the Vite proxy forwards /uploads to the API.
# In a split deployment set it to the API origin, e.g. https://api.example.com
VITE_ASSET_URL=
