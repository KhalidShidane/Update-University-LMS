# Server
PORT=5000
NODE_ENV=development

# Database - local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/university_lms

# Database - MongoDB Atlas (alternative, do NOT commit real credentials)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/university_lms

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# File upload
MAX_FILE_SIZE_MB=15

# CORS - frontend origin
CLIENT_URL=http://localhost:5173
